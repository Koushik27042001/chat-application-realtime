PORT=5000
CLIENT_URL=
MONGO_URI=
# If Node fails with querySrv ECONNREFUSED locally (Windows DNS), uncomment:
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
# Or paste Atlas "standard" (non+srv) connection string into MONGO_URI instead.
JWT_SECRET=

# Password reset and OTP emails. Gmail users must create an App Password after
# enabling 2-Step Verification. Render environment values should not include quotes.
# Preferred in production (faster + more reliable than SMTP on many hosts):
# RESEND_API_KEY=
# EMAIL_FROM=onboarding@your-verified-domain.com
#
# SMTP fallback:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Force IPv4 lookup for SMTP (helps on hosts with broken IPv6 routes)
SMTP_FORCE_IPV4=true
SMTP_USER=
SMTP_PASS=
# Optional, useful for SMTP providers that require a verified sender:
# SMTP_FROM="Chat App <noreply@example.com>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative accepted by backend:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_FOLDER=chat-app
# Max accepted image data URL length for chat/photo uploads. Default: 8000000
# MAX_IMAGE_DATA_URL_LENGTH=8000000

# Defaults: access token 7d, bcrypt cost 10 (faster signup/login on small servers)
# JWT_EXPIRES_IN=7d
# BCRYPT_COST=10
# JWT_REFRESH_SECRET=   # defaults to JWT_SECRET if unset

# After first user registers with this email, each server start assigns role admin
ADMIN_EMAIL=

# Admin UI: open /admin/admin_koushik/login (see backend & frontend config/adminPanel.js)
ADMIN_LOGIN_USER_ID=
ADMIN_LOGIN_PASSWORD=
ADMIN_PANEL_SECRET=
ADMIN_NAME=

# Firebase Admin - recommended for Render / production (no JSON file on disk)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, real newlines as \n e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Optional local only: path to JSON relative to project root - only used if file exists
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
